# Copy this file to `.env` (gitignored — never commit the real one) and
# fill in the local values printed by `supabase status` from the repo root.
#
# These are LOCAL Supabase defaults only. The service-role key bypasses RLS
# entirely, so it must never be used anywhere except these local ingestion
# scripts (PRD D18/D19/D21).

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-SERVICE_ROLE_KEY-from-supabase-status

# Optional (task #79/PRD D9): API-Sports free-tier key. ingest:fixtures runs
# cleanly without this — it just skips API-Sports and falls back to
# Wikipedia season-article fixtures. Leave unset until a key is issued.
API_SPORTS_KEY=

# Optional (task #78/PRD D2/D4). ingest:sentiment runs cleanly without
# these — Reddit and/or Guardian just stay OFF (logged, non-error) and no
# live call is ever made to either. Leave both unset until task #67's
# Reddit OAuth app registration and a Guardian Open Platform key exist.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# GUARDIAN_API_KEY=
